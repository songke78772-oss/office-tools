# Copy this to .env and fill in your values

# Session secret (generate a random string)
SESSION_SECRET=your-super-secret-session-key-change-me

# Stripe keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price ID for the $1.99/month plan
# Create product in Stripe Dashboard: Product name "Office Tools Pro", Price $1.99 USD recurring monthly
# Then copy the Price ID (starts with price_)
STRIPE_PRICE_ID=price_your_price_id_here

# Admin password for uploading tools
ADMIN_PASSWORD=your-admin-password-here

# App URL (for success/cancel redirects and webhooks)
# Local: http://localhost:3000
# Production: https://yourdomain.com
APP_URL=http://localhost:3000

# Port
PORT=3000
