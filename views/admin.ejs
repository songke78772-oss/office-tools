<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin - Office Tools Pro</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
  <div class="max-w-4xl mx-auto p-6">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold">Admin Dashboard</h1>
      <a href="/logout" class="text-gray-600">Logout</a>
    </div>

    <div class="bg-white rounded shadow p-6 mb-8">
      <h2 class="text-lg font-semibold mb-4">Upload New Tool</h2>
      <form method="POST" action="/admin/upload" enctype="multipart/form-data">
        <div class="mb-3">
          <label class="block text-sm">Tool Name</label>
          <input type="text" name="name" required class="w-full border p-2 rounded">
        </div>
        <div class="mb-3">
          <label class="block text-sm">Description</label>
          <textarea name="description" class="w-full border p-2 rounded" rows="3"></textarea>
        </div>
        <div class="mb-3">
          <label class="block text-sm">Version</label>
          <input type="text" name="version" value="1.0" class="w-full border p-2 rounded">
        </div>
        <div class="mb-4">
          <label class="block text-sm">File</label>
          <input type="file" name="file" required class="w-full">
        </div>
        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded">Upload Tool</button>
      </form>
    </div>

    <h2 class="text-lg font-semibold mb-4">Existing Tools</h2>
    <div class="space-y-3">
      <% tools.forEach(tool => { %>
        <div class="bg-white p-4 rounded shadow flex justify-between items-center">
          <div>
            <strong><%= tool.name %></strong> (v<%= tool.version %>)<br>
            <span class="text-sm text-gray-500"><%= tool.filename %></span>
          </div>
          <form method="POST" action="/admin/delete/<%= tool.id %>" onsubmit="return confirm('Delete this tool?')">
            <button type="submit" class="text-red-600 text-sm">Delete</button>
          </form>
        </div>
      <% }) %>
      <% if (tools.length === 0) { %><p>No tools yet.</p><% } %>
    </div>
  </div>
</body>
</html>
